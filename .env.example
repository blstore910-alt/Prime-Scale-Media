NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
RESEND_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_WEBHOOK_SECRET=
# Set to true during incident response to freeze all writes.
# Reads keep working; every server action returns forbidden.
MAINTENANCE_MODE=

# Integration adapters — mock by default, "live" to hit real APIs.
SEAMX_MODE=
WISE_MODE=

# Wise incoming-payment webhook (auto-detect bank top-ups).
# WISE_PUBLIC_KEY: Wise's RSA public key (PEM) used to verify webhook
#   signatures. Without it the /api/webhooks/wise endpoint refuses
#   every event. Get it from the Wise developer portal (sandbox + prod
#   keys differ).
WISE_PUBLIC_KEY=
# WISE_API_TOKEN: read-scoped personal token for fetching transfer
#   detail when a webhook payload lacks the reference. Keep secret.
WISE_API_TOKEN=

